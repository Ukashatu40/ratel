# Settings for the app on bss-app. Install as /etc/ratel-app/ratel-app.env, owned by the service
# user ratelbss, mode 0600. NEVER commit the real file. Values below are placeholders.
# Every setting is explained in docs/ENVIRONMENTS.md.

# lab, staging or production. Outside local and test the app refuses to start without METER_API_KEY and PAY_API_KEY.
RATEL_ENV=lab
LOG_LEVEL=INFO

# PostgreSQL on this host only, as the runtime role (deploy/bss-app/postgres-roles.sql), which can
# read and write rows but cannot change the schema. If the password contains characters other than
# letters and digits, URL-encode it.
DATABASE_URL=postgresql+psycopg://ratel_app:<password>@127.0.0.1:5432/ratel_bss

# Redis on this host only. Not used by any code yet (idempotency keys, M-26).
REDIS_URL=redis://127.0.0.1:6379/0

# RatelLink on core-cp, through its TLS proxy (deploy/core-cp/nginx/). Use the proxy's https address.
RATEL_LINK_BASE_URL=https://<ratel-link-proxy-name>
RATEL_LINK_API_KEY=CHANGE_ME

# The key the meter agents send to POST /v1/usage. No default: unset, empty or CHANGE_ME means the
# usage API refuses every request.
METER_API_KEY=CHANGE_ME

# The key the reverse proxy adds to the public voucher redemption route (the RatelPay page sends
# none). The same value is in /etc/nginx/ratel-pay-key.conf. No default: unset, empty or CHANGE_ME
# means that route refuses every request, and outside local and test the app refuses to start.
PAY_API_KEY=CHANGE_ME

# RatelLink's proxy on core-cp has a self-signed certificate, so the app must be told to trust it.
# Build one file with the system's authorities FIRST (the payment gateway, later, uses a public
# one) and RatelLink's public certificate after them:
#   cat /etc/ssl/certs/ca-certificates.crt ratel-link-cert.pem | sudo tee /etc/ratel-app/ca-bundle.pem
# Set it to a bundle, never to the one certificate alone, or every other HTTPS call will fail.
SSL_CERT_FILE=/etc/ratel-app/ca-bundle.pem
