# Runs ratel-pgbackup.service once a day. Install as /etc/systemd/system/ratel-pgbackup.timer, then:
#   sudo systemctl enable --now ratel-pgbackup.timer
# Check it: systemctl list-timers ratel-pgbackup.timer
[Unit]
Description=RatelBSS: daily dump of the PostgreSQL database

[Timer]
# Daily, in the host's time (UTC). Persistent: a run missed while the host was off happens at boot, which matters
# because the servers lose power every night.
OnCalendar=daily
Persistent=true
RandomizedDelaySec=15min
Unit=ratel-pgbackup.service

[Install]
WantedBy=timers.target
