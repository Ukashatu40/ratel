# The nightly dump of RatelBSS's database (deploy/bss-app/ratel-pgbackup.sh, installed as /usr/local/sbin/ratel-pgbackup).
# Install as /etc/systemd/system/ratel-pgbackup.service (deploy/bss-app/README.md, "Backups"). It is started by
# ratel-pgbackup.timer, not enabled by itself.
#
# Runs as `postgres` so it can read every table over the local socket without a password. Exit 0: a dump was made, read
# back and kept. Anything else: the unit shows as failed (systemctl status ratel-pgbackup) and no half-made file is left.
# TODO(RatelOps): turn a failed unit into an alert; copy the dumps off the host, encrypted.
[Unit]
Description=RatelBSS: dump the PostgreSQL database
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/local/sbin/ratel-pgbackup
TimeoutStartSec=30min
UMask=0077

# Hardening: it needs the database socket and one folder to write to, and nothing else.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
ReadWritePaths=/var/backups/ratel-bss
