# The nightly encrypted dump of RatelBSS's database (deploy/bss-app/ratel-bss-backup.sh, installed as
# /usr/local/sbin/ratel-bss-backup). Install as /etc/systemd/system/ratel-bss-backup.service (deploy/bss-app/README.md,
# "Backups"). It is started by ratel-bss-backup.timer, not enabled by itself. Not named ratel-pgbackup: the network team's
# older unit has that name and dumps a container, not this database.
#
# Runs as `postgres` so it can read every table over the local socket without a password. Exit 0: a dump was made, read
# back, encrypted and kept. Anything else: the unit shows as failed (systemctl status ratel-bss-backup) and no half-made
# or plain file is left. TODO(RatelOps): turn a failed unit into an alert; copy the dumps off the host.
[Unit]
Description=RatelBSS: encrypted dump of the PostgreSQL database
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/local/sbin/ratel-bss-backup
TimeoutStartSec=30min
UMask=0077

# Hardening: it needs the database socket, the public-key file (read) and one folder to write to, and nothing else.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
ReadWritePaths=/var/backups/ratel-bss
