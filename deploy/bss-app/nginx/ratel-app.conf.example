# The reverse proxy in front of the app on bss-app. Install as /etc/nginx/conf.d/ratel-app.conf
# after replacing every <placeholder>. This is a template: the network team may use another proxy.
#
# Who may reach what (docs/ARCHITECTURE.md): RatelPay and the payment webhook are the only public
# paths. Everything else is for the office network and the VPN, plus the meter agents' addresses on
# the usage ingest path. The public paths: the RatelPay page (one static file, /pay), the three
# calls the page makes (redeem a card, start a payment, follow a payment) and Paystack's webhook.

limit_req_zone $binary_remote_addr zone=ratel_app:1m rate=20r/s;
# Redeeming a card. Many customers share one address on a mobile network, so this is generous; the
# real limit is the app's 5 failed attempts per card number per hour.
limit_req_zone $binary_remote_addr zone=ratel_redeem:1m rate=30r/m;
# Starting and following a payment (the RatelPay page), and the gateway's notifications.
limit_req_zone $binary_remote_addr zone=ratel_pay:1m rate=30r/m;
limit_req_zone $binary_remote_addr zone=ratel_webhook:1m rate=120r/m;

# Staff sign-in. The app locks an account after 5 wrong passwords; this limits one address trying
# many accounts.
limit_req_zone $binary_remote_addr zone=ratel_login:1m rate=10r/m;

# The access log records who called and the result, never the path: paths contain IMSIs.
log_format ratel_app_privacy '$time_iso8601 $remote_addr "$request_method" $status $request_length $request_time';

server {
    listen 443 ssl;
    server_name <name-of-this-host>;

    ssl_certificate     /etc/ssl/ratel-app/fullchain.pem;
    ssl_certificate_key /etc/ssl/ratel-app/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    access_log /var/log/nginx/ratel-app.access.log ratel_app_privacy;

    client_max_body_size 1m;
    limit_req zone=ratel_app burst=40 nodelay;
    limit_req_status 429;

    # The meter agents post usage and calls here. Only their addresses.
    location /v1/usage {
        allow <address-of-core-up>;
        allow <address-of-voice-vm>;
        allow <office-and-vpn-range>;
        deny  all;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 30s;
    }

    # The voice VM's call agent posts call records here. Calls are personal data (who called whom): the
    # voice VM and the office, nobody else. An exact match, so nothing else under /v1/calls opens up.
    location = /v1/calls {
        allow <address-of-voice-vm>;
        allow <office-and-vpn-range>;
        deny  all;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 30s;
    }

    # PUBLIC: the RatelPay page. One static file from the release (web/pay/index.html), read-only, and
    # the only thing served from disk. The page keeps its CSS and script inside the file, so the policy
    # allows nothing else to load; it may call only this host (connect-src 'self'). It sets no cookie
    # and stores nothing but a payment id. The browser re-checks it on every visit (no-cache), so a new
    # release shows at once.
    location = /pay {
        limit_except GET HEAD { deny all; }
        alias /opt/ratel-app/current/web/pay/index.html;
        default_type text/html;  # /pay has no extension, so nginx would not know it is a page and the browser would download it
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    # PUBLIC PATH: the RatelPay page redeems a prepaid card here. An exact match, so nothing else
    # under /v1/pay is public. The page is a static file in a browser and cannot keep a key secret,
    # so it sends none: the included file adds the redemption key (PAY_API_KEY) and REPLACES any
    # Authorization header the browser sent. That keeps the app's rule that every call has a key; it
    # does not stop someone who calls this proxy, and is not meant to. What stops guessing is the
    # app's 5 failed attempts per card number per hour, and the limit below. A small body (the
    # request is under 150 bytes), and no body in any log (the log format above has none).
    location = /v1/pay/vouchers/redeem {
        limit_req zone=ratel_redeem burst=10 nodelay;
        limit_req_status 429;
        client_max_body_size 1k;
        include /etc/nginx/ratel-pay-key.conf;  # proxy_set_header Authorization "Bearer <key>";
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 10s;
    }

    # PUBLIC: the RatelPay page starts a payment and follows it. Exact matches, so nothing else under
    # /v1/pay is public. The payment id in the second path cannot be guessed (24 random bytes), and
    # the app checks its length. Like the redeem path, the included file adds the proxy's key.
    location = /v1/pay/payments {
        limit_req zone=ratel_pay burst=10 nodelay;
        limit_req_status 429;
        client_max_body_size 2k;
        include /etc/nginx/ratel-pay-key.conf;  # proxy_set_header Authorization "Bearer <key>";
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 20s;
    }
    location ~ ^/v1/pay/payments/[A-Za-z0-9_-]+$ {
        limit_req zone=ratel_pay burst=30 nodelay;
        limit_req_status 429;
        include /etc/nginx/ratel-pay-key.conf;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 20s;
    }

    # Paystack's notifications. Only the addresses Paystack publishes for its webhooks (list them from
    # Paystack's documentation, then `deny all`): the signature the app checks is the real protection,
    # this is a second wall. The body is Paystack's, a few kilobytes. A 5xx from here makes Paystack
    # deliver the notification again later, which is wanted.
    location = /v1/pay/webhooks/paystack {
        allow <paystack-address-1>;
        allow <paystack-address-2>;
        allow <paystack-address-3>;
        deny  all;
        limit_req zone=ratel_webhook burst=40 nodelay;
        limit_req_status 429;
        client_max_body_size 64k;
        include /etc/nginx/ratel-pay-key.conf;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 30s;
    }

    # Staff sign-in: office and VPN only, and slow. An exact match so nothing else gets this limit.
    location = /v1/auth/login {
        allow <office-and-vpn-range>;
        deny  all;
        limit_req zone=ratel_login burst=5 nodelay;
        limit_req_status 429;
        client_max_body_size 4k;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 10s;
    }

    # The rest of the API: staff only.
    location /v1/ {
        allow <office-and-vpn-range>;
        deny  all;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 30s;
    }

    # Liveness for the local monitor only.
    location = /healthz {
        allow 127.0.0.1;
        deny  all;
        proxy_pass http://127.0.0.1:8000;
    }

    # RatelDesk, the staff site: static files built by scripts/release/build-desk.sh, unpacked under /var/www/ratel-desk
    # (deploy/bss-app/README.md). Only the office network and the VPN, like the staff API it calls. An unknown address
    # inside the range gets the app's own page (the Desk draws its screens itself); outside it, 403. no-cache makes the
    # browser re-check each file, so a new release shows at once; the office network is fast enough for that.
    location / {
        allow <office-and-vpn-range>;
        deny  all;
        root /var/www/ratel-desk;
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
    }
}
