# Settings for RatelLink on core-cp. Install as /etc/ratel-link/ratel-link.env, owned by the
# service user, mode 0600. NEVER commit the real file. Values below are placeholders.
# Every setting is explained in docs/ENVIRONMENTS.md.

RATEL_ENV=lab
LOG_LEVEL=INFO

# MongoDB on this host only. The user is the one created by mongo/create-ratel-link-user.js.
# Replace <password>; if it contains characters other than letters and digits, URL-encode it.
MONGO_URI=mongodb://ratel_link:<password>@127.0.0.1:27017/?authSource=admin
# The core's subscriber database and RatelLink's own.
OPEN5GS_DB_NAME=open5gs
RATEL_LINK_DB_NAME=ratel_link

# The encryption key for stored Ki and OPc (ADR 0006). Created once with the admin CLI, owned by
# the service user, mode 0600, and backed up offline, never with the database.
RATEL_LINK_KEY_FILE=/etc/ratel-link/ratel_link.key
RATEL_LINK_KEY_ID=1

# The pool of fixed addresses given to lines. TODO(network team): the part of the internet pool that
# is outside the SMF's dynamic range (docs/RATELCORE_INTEGRATION_FACTS.md, N2).
RATEL_LINK_UE_POOL=10.45.0.0/16

# A subscriber document exported from the lab that has the ims (voice) session. TODO(network team):
# supply it (N1). Leave the line out until then: lines are activated without voice.
# RATEL_LINK_VOICE_TEMPLATE_FILE=/etc/ratel-link/ims-template.json

RATEL_LINK_API_KEY_MAX_AGE_DAYS=90
RATEL_LINK_API_KEY_ROTATION_OVERLAP_DAYS=7
RATEL_LINK_API_KEY_EXPIRY_WARN_DAYS=14
