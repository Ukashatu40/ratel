# Settings for RatelMeter's call agent on the voice VM. Install as /etc/ratel-meter/ratel-meter-calls.env,
# owned by user ratelmeter, mode 0600. NEVER commit the real file. Values below are placeholders.
# No comments after a value: systemd keeps them. Every setting is explained in deploy/voice/README.md.

# Where the RatelMeter API is (bss-app, over HTTPS, no port) and its key (the same value as METER_API_KEY there).
# Required: the agent does not start without the key.
METER_AGENT_METER_API_BASE_URL=http://127.0.0.1:18082
METER_AGENT_API_KEY=CHANGE_ME

# The certificate of bss-app (self-signed), as one file of PEM certificates, copied from there and checked
# against its fingerprint. Without it the agent refuses bss-app's certificate, which is the point.
SSL_CERT_FILE=/etc/ratel-meter/trusted-certs.pem

# Spool and state (batches waiting for the API, how far the agent has read, calls still open).
METER_AGENT_SPOOL_DIR=/var/spool/ratel-meter

# The fixed command that prints new rows (deploy/voice/ratel-call-export.sh behind the sudo rule).
METER_AGENT_CALL_EXPORT_COMMAND=/usr/bin/sudo -n /usr/local/sbin/ratel-call-export

# How often it looks, how long a row waits so a call's rows arrive together, and how long an answered call
# with no hang-up is kept before it is dropped and counted (seconds; 21600 is six hours).
METER_AGENT_CALL_INTERVAL_SECONDS=60
METER_AGENT_CALL_SETTLE_SECONDS=10
METER_AGENT_CALL_OPEN_MAX_SECONDS=21600
METER_AGENT_LOG_LEVEL=INFO
