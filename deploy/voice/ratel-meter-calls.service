# RatelMeter's call agent on the voice VM. Install as /etc/systemd/system/ratel-meter-calls.service
# (deploy/voice/README.md). It reads finished calls from the S-CSCF's accounting and posts them to bss-app.
[Unit]
Description=RatelMeter call agent (voice VM)
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=4

[Service]
Type=simple
User=ratelmeter
Group=ratelmeter
WorkingDirectory=/opt/ratel-meter/current
EnvironmentFile=/etc/ratel-meter/ratel-meter-calls.env
Environment=PYTHONPATH=/opt/ratel-meter/current/services
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/ratel-meter/current/venv/bin/python -m meter_agent.main --mode call
Restart=always
RestartSec=5
UMask=0077

# Hardening, less than the data agent's. This one runs `sudo` for the single export command, and on the voice VM's
# systemd (Ubuntu 22.04) every option that drops capabilities or installs a seccomp filter (PrivateDevices,
# ProtectKernel*, ProtectClock, ProtectHostname, RestrictNamespaces, RestrictRealtime, LockPersonality) makes `sudo`
# refuse with "no new privileges", even with NoNewPrivileges=no. Tested one option at a time on 2026-11-03: the five kept
# below work; the nine left out do not. What still protects the host: the agent can run exactly one command as root
# (deploy/voice/sudoers-ratel-meter.example), and that command takes three whole numbers and nothing else.
NoNewPrivileges=no
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectControlGroups=yes
ReadWritePaths=/var/spool/ratel-meter

[Install]
WantedBy=multi-user.target
