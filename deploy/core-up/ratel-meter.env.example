# Settings for RatelMeter agent on core-up. Install as /etc/ratel-meter/ratel-meter.env,
# owned by user ratelmeter, mode 0600. NEVER commit the real file. Values below are placeholders.
# Every setting is explained in docs/runbooks/ratel-meter.md.

METER_AGENT_MODE=data
METER_AGENT_LOG_LEVEL=INFO
METER_AGENT_INTERVAL_SECONDS=300

# RatelLink assignments endpoint and bearer token
METER_AGENT_RATEL_LINK_BASE_URL=http://127.0.0.1:4010
METER_AGENT_RATEL_LINK_API_KEY=CHANGE_ME

# RatelMeter API ingest endpoint and bearer token
METER_AGENT_METER_API_BASE_URL=http://127.0.0.1:18082
METER_AGENT_API_KEY=CHANGE_ME

# Spool directory for storing unacknowledged intervals
METER_AGENT_SPOOL_DIR=/var/spool/ratel-meter

# Optional snapshot file path (if reading from file dump rather than live counters)
# METER_AGENT_SNAPSHOT_PATH=/var/run/ratel-meter/counters.json
