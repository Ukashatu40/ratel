# Settings for RatelMeter agent on core-up. Install as /etc/ratel-meter/ratel-meter.env,
# owned by user ratelmeter, mode 0600. NEVER commit the real file. Values below are placeholders.
# Every setting is explained in docs/runbooks/ratel-meter.md.

METER_AGENT_MODE=data
METER_AGENT_LOG_LEVEL=INFO
METER_AGENT_INTERVAL_SECONDS=300

# RatelLink assignments endpoint and bearer token
METER_AGENT_RATEL_LINK_BASE_URL=http://127.0.0.1:4010
# Required: the agent does not start without either key. (No comments after a value: systemd keeps them.)
METER_AGENT_RATEL_LINK_API_KEY=CHANGE_ME

# RatelMeter API ingest endpoint and bearer token
METER_AGENT_METER_API_BASE_URL=http://127.0.0.1:18082
METER_AGENT_API_KEY=CHANGE_ME

# Spool directory for storing unacknowledged intervals
METER_AGENT_SPOOL_DIR=/var/spool/ratel-meter

# The counting table loaded by ratel-meter-nft.service (deploy/core-up/ratel-meter.nft) and how
# the agent reads it. Change these only if the table is renamed.
METER_AGENT_NFT_PATH=/usr/sbin/nft
METER_AGENT_NFT_FAMILY=inet
METER_AGENT_NFT_TABLE=ratel_meter
METER_AGENT_NFT_UP_SET=up
METER_AGENT_NFT_DOWN_SET=down
METER_AGENT_NFT_TIMEOUT_SECONDS=10

# Tests and replays only: read a recorded nft JSON file instead of running nft. Leave unset on core-up.
# METER_AGENT_SNAPSHOT_PATH=/path/to/recorded-snapshot.json

# The certificates of the servers the agent calls over HTTPS (RatelLink's proxy on core-cp and the
# RatelMeter API on bss-app), as one file of PEM certificates. Public halves only, copied from those
# hosts, and checked against the fingerprint their script printed. Without it the agent refuses their
# self-signed certificates, which is the point. Python reads it from this variable.
SSL_CERT_FILE=/etc/ratel-meter/trusted-certs.pem
