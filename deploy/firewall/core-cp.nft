# Inbound firewall for core-cp. Install as /etc/ratel-fw/ratel-fw.nft; ratel-fw.service loads it at
# boot (deploy/firewall/README.md). The addresses are not in this file: it reads them from
# /etc/ratel-fw/addresses.nft on the host (see addresses.nft.example), because the repository is public.
#
# Policy is drop. What is let in: replies to connections the host started, loopback (the Open5GS
# functions talk to each other there), ping, SSH, S1 from the radios, and PFCP from core-up.
# Only inbound is filtered. The table is its own, so it does not touch any other nftables or
# iptables rule on the host, and a reload replaces it instead of stacking a second copy.
#
# Check the syntax without applying it:   sudo nft -c -f /etc/ratel-fw/ratel-fw.nft
include "/etc/ratel-fw/addresses.nft"

table inet ratel_fw
delete table inet ratel_fw

table inet ratel_fw {
    chain input {
        type filter hook input priority filter; policy drop;

        ct state established,related accept
        ct state invalid drop
        iifname "lo" accept
        meta l4proto { icmp, ipv6-icmp } accept

        # SSH is key-only (PasswordAuthentication no), so it stays open to any address, but one
        # address cannot open more than 10 new connections a minute.
        tcp dport 22 ct state new meter ssh_new4 { ip saddr timeout 1m limit rate over 10/minute burst 10 packets } drop
        tcp dport 22 ct state new meter ssh_new6 { ip6 saddr timeout 1m limit rate over 10/minute burst 10 packets } drop
        tcp dport 22 accept

        # The radios' S1 association with the MME.
        ip saddr $radios sctp dport 36412 accept

        # PFCP: the SGW-C and the SMF talk to the SGW-U and the UPF on core-up.
        ip saddr $core_up udp dport { 8805, 8806 } accept

        # RatelLink's TLS proxy (deploy/core-cp/nginx): the two callers, HTTPS only. The proxy itself
        # also admits only these two addresses. Both names must be in /etc/ratel-fw/addresses.nft
        # BEFORE this file is loaded, or the load fails and the host has no firewall.
        ip saddr { $core_up, $bss_app } tcp dport 443 accept

        # Not a verdict: it counts what the policy then drops (sudo nft list chain inet ratel_fw input).
        counter
    }
}
