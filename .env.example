# Copy to .env for LOCAL development only. Never commit a real .env.
# Every value below is a placeholder. There are no real secrets in this file.
#
# Production, staging/pilot and lab secrets live in environment files on each host
# (owner-only permissions, outside Git). See docs/ENVIRONMENTS.md.

# --- General -----------------------------------------------------------------
# One of: local | test | lab | staging | production
RATEL_ENV=local
LOG_LEVEL=INFO

# --- Local dev containers (compose.dev.yaml) ---------------------------------
# Choose your own throwaway local values. Do not reuse any real password.
POSTGRES_USER=ratel_dev
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ratel_bss
REDIS_PASSWORD=CHANGE_ME
MONGO_ROOT_USER=ratel_dev
MONGO_ROOT_PASSWORD=CHANGE_ME

# --- app (RatelBSS, RatelMeter API) ------------------------------------------
DATABASE_URL=postgresql+psycopg://ratel_dev:CHANGE_ME@127.0.0.1:5432/ratel_bss
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
# Where RatelBSS reaches RatelLink. Local default points at the mock (make mock).
RATEL_LINK_BASE_URL=http://127.0.0.1:4010
# The API key RatelBSS presents to RatelLink (one key per calling system, ADR 0007). This holds the
# bare key value, rlk_<api_key_id>.<secret>. The app sends it as "Authorization: Bearer <key>".
# Created with: python -m ratel_link.admin_cli api-key create --id bss-app --name RatelBSS
RATEL_LINK_API_KEY=CHANGE_ME

# --- ratel-link (runs on core-cp only) ---------------------------------------
# Must resolve to 127.0.0.1/localhost. Config validation rejects anything else.
MONGO_URI=mongodb://ratel_dev:CHANGE_ME@127.0.0.1:27017/?authSource=admin
OPEN5GS_DB_NAME=open5gs
RATEL_LINK_DB_NAME=ratel_link
# Path to the file holding the key that encrypts Ki/OPc at rest (ADR 0006). The file holds base64
# of 32 random bytes. It must be a regular file owned by the service user with no group or other
# permissions, or RatelLink will not start. Outside local/test it is required. The key is NOT in
# MongoDB and NOT in this file. Create it with: python -m ratel_link.admin_cli key generate --out PATH
RATEL_LINK_KEY_FILE=/path/outside/repo/ratel_link.key
# Id stored in each encrypted record, so a later key can be told apart. Lowercase letters, digits, . _ -
RATEL_LINK_KEY_ID=1
# The pool of fixed IPv4 addresses given to lines (Build Plan: 10.45.0.0/16 in the lab). A private
# IPv4 network. The network and broadcast addresses and the first host (the gateway) are never given out.
RATEL_LINK_UE_POOL=10.45.0.0/16
# API key lifetime in days. 1 to 90. Values above 90 are rejected (Build Plan: rotated every 90 days).
RATEL_LINK_API_KEY_MAX_AGE_DAYS=90
# After "api-key rotate", how many days the old key keeps working. 1 to 30 (ADR 0007).
RATEL_LINK_API_KEY_ROTATION_OVERLAP_DAYS=7
# Log api_key.expiring for keys this close to expiry. 1 to 90.
RATEL_LINK_API_KEY_EXPIRY_WARN_DAYS=14

# --- meter-agent (core-up: data mode, voice: call mode) ----------------------
METER_AGENT_MODE=data
METER_API_BASE_URL=http://127.0.0.1:4010
METER_API_KEY=CHANGE_ME
# The key the agent presents to RatelLink for GET /v1/assignments. Its own key, separate from
# RatelBSS's (one key per calling system, api_key_id meter-agent). Bare key value, sent as
# "Authorization: Bearer <key>".
METER_AGENT_RATEL_LINK_API_KEY=CHANGE_ME
METER_SPOOL_DIR=/var/lib/ratel-meter/spool
# TODO: confirm production host details, network-team contact, payment provider.
