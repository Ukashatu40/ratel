# Copy to .env for LOCAL development only. Never commit a real .env.
# Every value below is a placeholder. There are no real secrets in this file.
#
# Production, staging/pilot and lab secrets live in environment files on each host
# (owner-only permissions, outside Git). See docs/ENVIRONMENTS.md.

# --- General -----------------------------------------------------------------
# One of: local | test | lab | staging | production
RATEL_ENV=local
LOG_LEVEL=INFO

# --- Local dev containers (compose.dev.yaml) ---------------------------------
# Choose your own throwaway local values. Do not reuse any real password.
POSTGRES_USER=ratel_dev
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ratel_bss
REDIS_PASSWORD=CHANGE_ME
MONGO_ROOT_USER=ratel_dev
MONGO_ROOT_PASSWORD=CHANGE_ME

# --- app (RatelBSS, RatelMeter API) ------------------------------------------
DATABASE_URL=postgresql+psycopg://ratel_dev:CHANGE_ME@127.0.0.1:5432/ratel_bss
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
# Where RatelBSS reaches RatelLink. Local default points at the mock (make mock).
RATEL_LINK_BASE_URL=http://127.0.0.1:4010
# The API key RatelBSS presents to RatelLink (one key per calling system).
RATEL_LINK_API_KEY=CHANGE_ME

# --- ratel-link (runs on core-cp only) ---------------------------------------
# Must resolve to 127.0.0.1/localhost. Config validation rejects anything else.
MONGO_URI=mongodb://ratel_dev:CHANGE_ME@127.0.0.1:27017/?authSource=admin
OPEN5GS_DB_NAME=open5gs
RATEL_LINK_DB_NAME=ratel_link
# Path to a file holding the key that encrypts Ki/OPc at rest. The key is NOT in
# MongoDB and NOT in this file. TODO: key format and rotation (open decision, see docs/DECISIONS_PENDING.md).
RATEL_LINK_KEY_FILE=/path/outside/repo/ratel_link.key

# --- meter-agent (core-up: data mode, voice: call mode) ----------------------
METER_AGENT_MODE=data
METER_API_BASE_URL=http://127.0.0.1:4010
METER_API_KEY=CHANGE_ME
METER_SPOOL_DIR=/var/lib/ratel-meter/spool
# TODO: confirm production host details, network-team contact, payment provider.
